{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    },
    "src/app/api/inngest/route.ts": {
      "maxDuration": 60
    }
  },
  "env": {
    "NPM_CONFIG_FUND": "false",
    "NPM_CONFIG_AUDIT": "false"
  },
  "crons": [
    {
      "path": "/api/cron/daily-alerts",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/weekly-alerts",
      "schedule": "0 9 * * 1"
    }
  ]
}
